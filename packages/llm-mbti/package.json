{
  "name": "llm-mbti",
  "version": "0.1.0",
  "description": "Run an MBTI-style personality questionnaire (OEJTS 1.2) against an LLM locally, and optionally share the result.",
  "type": "module",
  "license": "(MIT AND CC-BY-NC-SA-4.0)",
  "bin": {
    "llm-mbti": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@llm-mbti/questionnaire": "workspace:*",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mieluoxxx/llm-mbti.git"
  },
  "homepage": "https://github.com/Mieluoxxx/llm-mbti"
}
